{
  "name": "fullstackapp",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "oxlint": "^1.74.0",
    "prettier": "^3.7.4",
    "turbo": "^2.10.5",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.6.2"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
