generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma/client"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String          @id @unique @default(uuid())
  email            String          @unique
  emailVerified    Boolean         @default(false)
  image            String?
  userName         String          @unique @db.VarChar(32)
  displayName      String          @db.VarChar(32)
  status           UserStatus      @default(OFFLINE)
  lastSeen         DateTime        @default(now())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  receivedMessages DirectMessage[] @relation("ReceivedDirectMessages")
  sentMessages     DirectMessage[] @relation("SentDirectMessages")
  settings         UserSettings?
  friends          User[]          @relation("UserFriends")
  friendOf         User[]          @relation("UserFriends")
  ownedGroupChats  GroupChat[]     @relation("GroupChatOwner")
  groupChats       GroupChat[]     @relation("GroupChatMembers")
  groupMessages    GroupMessage[]
  sessions         Session[]
  accounts         Account[]
}

model UserSettings {
  id            Int     @id @unique @default(autoincrement())
  notifications Boolean @default(true)
  soundEnabled  Boolean @default(true)
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DirectMessage {
  id         String   @id @unique
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  senderId   String
  receiverId String
  receiver   User     @relation("ReceivedDirectMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User     @relation("SentDirectMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([receiverId, senderId, createdAt])
}

model GroupChat {
  id        Int            @id @unique @default(autoincrement())
  name      String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  ownerId   String
  owner     User           @relation("GroupChatOwner", fields: [ownerId], references: [id])
  members   User[]         @relation("GroupChatMembers")
  messages  GroupMessage[]

  @@index([ownerId])
}

model GroupMessage {
  id        String    @id @unique
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isEdited  Boolean   @default(false)
  groupId   Int
  senderId  String
  group     GroupChat @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender    User      @relation(fields: [senderId], references: [id])

  @@index([groupId])
  @@index([senderId])
  @@index([groupId, createdAt])
}

enum UserStatus {
  ONLINE
  IDLE
  DO_NOT_DISTURB
  OFFLINE
}

enum ChannelType {
  TEXT
  VOICE
}

model Session {
  id        String   @id @unique @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @unique @default(uuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @unique @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}
